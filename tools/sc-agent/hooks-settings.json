    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "~/.claude/sc-hook.sh", "async": true }] }
