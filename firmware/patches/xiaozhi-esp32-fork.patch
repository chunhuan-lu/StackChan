+// [StackChan fork] The activation task (version check, protocol); background: while in standby (offline first).
+void Application::StartActivation(bool background) {
+    if (activation_task_handle_ != nullptr) {
+        ESP_LOGW(TAG, "Activation task already running");
+        return;
+    }
+    background_activation_ = background;
+#if CONFIG_SC_OFFLINE_FIRST
+    hal_bridge::set_network_busy(true);
+#endif
+    xTaskCreate([](void* arg) {
+        Application* app = static_cast<Application*>(arg);
+        app->ActivationTask();
+        app->activation_task_handle_ = nullptr;
+        vTaskDelete(NULL);
+    }, "activation", 4096 * 2, this, 2, &activation_task_handle_);
+}
+
+#if CONFIG_SC_OFFLINE_FIRST
+// [StackChan fork] Offline first: a conversation needs the network. Without Wi-Fi: say so and stay in standby; with
+// Wi-Fi but no server connection yet: connect now and open the conversation when that is done. True: not now.
+bool Application::OfflineGate() {
+    if (!WifiManager::GetInstance().IsConnected()) {
+        ShowNoNetworkNotice();
+        return true;
+    }
+    if (!protocol_) {
+        ESP_LOGI(TAG, "Conversation requested: connecting to the server first");
+        pending_chat_ = true;
+        StartActivation(true);
+        return true;
+    }
+    return false;
+}
+
+// The network start is over (done, or no network): a wake word start that waited for it happens now, then face
+// detection may load its model again.
+void Application::NetworkStartDone() {
+    // The wake word model first: its load peak is over before face detection loads its model.
+    if (wake_word_deferred_ && GetDeviceState() == kDeviceStateIdle) {
+        wake_word_deferred_ = false;
+        wake_word_started_  = true;
+        audio_service_.EnableWakeWordDetection(true);
+    }
+    hal_bridge::set_network_busy(false);
+}
+
+void Application::ShowNoNetworkNotice() {
+    ESP_LOGW(TAG, "No network: conversation not started");
+    hal_bridge::show_notice("No network. Please connect to the internet first.", 5000);
+    audio_service_.PlaySound(Lang::Sounds::OGG_EXCLAMATION);
+}
+#endif
